# ------------------------------
Thumbs.db
ehthumbs.db
desktop.ini

# ------------------------------
# VIRTUAL ENVIRONMENT / PIP
# ------------------------------
pip-wheel-metadata/
*.whl

# ------------------------------
# POWER BI / DASHBOARDS / OUTPUT
